# AI Pentester configuration — copy to `.env` (in this directory) and edit.
# All PENTEST_* variables are optional; defaults are shown commented out.

# --- Which directory may scans target? --------------------------------------
# This single approved root is a hard security boundary: paths outside it
# (and symlinks escaping it) are always refused, verified by /api/quality.
# Defaults to the bundled samples/ directory next to this file. Point it at
# wherever your projects live, e.g.:
#   Windows:  PENTEST_SCAN_ROOT=C:\Users\you\projects
#   POSIX:    PENTEST_SCAN_ROOT=/home/you/my-projects
# PENTEST_SCAN_ROOT=C:\Users\you\projects

# --- Where state lives (SQLite db, sandbox) — never holds source trees ------
# Defaults to <project root>/data
#   Windows:  PENTEST_DATA_DIR=C:\Users\you\aipentester-data
# PENTEST_DATA_DIR=

# --- Scanner ----------------------------------------------------------------
# PENTEST_SEMGREP_BIN=semgrep            # binary name or full path
# PENTEST_SEMGREP_TIMEOUT_SECONDS=300
# PENTEST_MAX_FILES=5000
# PENTEST_MAX_FILE_BYTES=1000000
# PENTEST_MAX_TOTAL_BYTES=200000000
# PENTEST_MAX_DEPTH=24
# PENTEST_MAX_CANDIDATES_PERSIST=200

# --- AI investigator (milestone 4 — not wired yet) --------------------------
# Provider-agnostic: any OpenAI-compatible endpoint or Anthropic works; it is
# fine to leave everything below unset today — the AI stage simply stays off.
# The key is read only from this file/environment, never logged nor persisted.
# PENTEST_AI_PROVIDER=openai_compatible   # openai_compatible | anthropic | none
# PENTEST_AI_BASE_URL=https://api.example.com/v1
# PENTEST_AI_MODEL=my-model-name
# PENTEST_AI_API_KEY=                     # leave empty unless you have one

# --- Misc -------------------------------------------------------------------
# PENTEST_DEBUG=false
